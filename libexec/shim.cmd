@echo off
rem jenv shim for cmd.exe and PowerShell. Generated by 'jenv rehash' - do not edit the copies in shims\.
rem Resolution order: JENV_VERSION env var > nearest .java-version file > global version file.
setlocal
if not defined JENV_HOME for %%I in ("%~dp0..") do set "JENV_HOME=%%~fI"
set "JENV_TOOL=%~n0"
set "JENV_V=%JENV_VERSION%"
if defined JENV_V goto have
set "JENV_D=%CD%"

:up
if exist "%JENV_D%\.java-version" goto readlocal
for %%I in ("%JENV_D%\..") do set "JENV_P=%%~fI"
if /i "%JENV_P%"=="%JENV_D%" goto global
set "JENV_D=%JENV_P%"
goto up

:readlocal
set /p JENV_V=<"%JENV_D%\.java-version"
goto have

:global
if exist "%JENV_HOME%\version" set /p JENV_V=<"%JENV_HOME%\version"

:have
if not defined JENV_V goto noversion
if not exist "%JENV_HOME%\versions\%JENV_V%" goto notregistered
set /p JENV_JDK=<"%JENV_HOME%\versions\%JENV_V%"
if not exist "%JENV_JDK%\bin\%JENV_TOOL%.exe" goto notool
set "JAVA_HOME=%JENV_JDK%"
"%JENV_JDK%\bin\%JENV_TOOL%.exe" %*
exit /b %ERRORLEVEL%

:noversion
echo jenv: no Java version selected. Run 'jenv global ^<name^>' or 'jenv local ^<name^>'. 1>&2
exit /b 1

:notregistered
echo jenv: version '%JENV_V%' is not registered. Run 'jenv versions'. 1>&2
exit /b 1

:notool
echo jenv: '%JENV_TOOL%' is not available in JDK '%JENV_V%' at %JENV_JDK% 1>&2
exit /b 1
